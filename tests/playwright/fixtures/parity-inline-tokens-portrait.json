{
	"layout_schema_version": 2,
	"page": { "size": "letter", "orientation": "portrait", "width": 612, "height": 792 },
	"background": { "color": "#ffffff", "attachment_id": 0 },
	"elements": [
		{
			"id": "el_inptitle", "type": "text", "x": 56, "y": 140, "w": 500, "h": 46, "z": 1,
			"props": {
				"content": "Certificate of Completion",
				"font_family": "playfair-display", "font_size": 30, "color": "#1f2a44",
				"align": "center", "line_height": 1.2, "bold": true, "italic": false
			}
		},
		{
			"id": "el_inpmulti", "type": "text", "x": 56, "y": 300, "w": 500, "h": 64, "z": 2,
			"props": {
				"content": "Awarded to {{recipient.display_name}}\nby {{site.name}}",
				"font_family": "eb-garamond", "font_size": 20, "color": "#1f2a44",
				"align": "center", "line_height": 1.4, "bold": false, "italic": false
			}
		},
		{
			"id": "el_inpexpir", "type": "text", "x": 56, "y": 430, "w": 500, "h": 32, "z": 3,
			"props": {
				"content": "Expires: {{certificate.expiry_date}}",
				"font_family": "eb-garamond", "font_size": 17, "color": "#4a5568",
				"align": "center", "line_height": 1.3, "bold": false, "italic": false
			}
		}
	]
}
