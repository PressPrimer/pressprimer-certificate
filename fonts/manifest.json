                    }
                },
                "bold": {
                    "tcpdf_font": "sourcesans3b",
                    "ttf": "source-sans-3/SourceSans3-Bold.ttf",
                    "metrics": {
                        "ascent": 1000,
                        "descent": -326,
                        "cap_height": 652,
                        "units": "per-1000-em"
                    }
                },
                "italic": {
                    "tcpdf_font": "sourcesans3it",
                    "ttf": "source-sans-3/SourceSans3-It.ttf",
                    "metrics": {
                        "ascent": 1000,
                        "descent": -326,
                        "cap_height": 656,
                        "units": "per-1000-em"
                    }
                },
                "bold_italic": {
                    "tcpdf_font": "sourcesans3bit",
                    "ttf": "source-sans-3/SourceSans3-BoldIt.ttf",
